{
  "name": "@pglevy/sailwind",
  "version": "0.20.0",
  "description": "Appian SAIL components for React - Pre-release version under active development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./index.css": "./dist/index.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "appian",
    "sail",
    "components",
    "react",
    "prototyping",
    "design-system",
    "ui-components"
  ],
  "author": "Philip Levy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pglevy/sailwind.git"
  },
  "bugs": {
    "url": "https://github.com/pglevy/sailwind/issues"
  },
  "homepage": "https://github.com/pglevy/sailwind#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "pnpm run generate:css && vite build --mode library && pnpm run build:tokens && pnpm run build:theme",
    "build:tokens": "tsx scripts/generate-palette-types.ts && tsx scripts/generate-tokens.ts && tsx scripts/validate-tokens.ts",
    "generate:css": "tsx scripts/generate-css.ts",
    "build:theme": "tsx scripts/generate-theme.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "pnpm run generate:css && storybook build",
    "check-page": "node scripts/quick-check.cjs",
    "check-page:full": "node scripts/full-check.cjs",
    "prepublishOnly": "pnpm run build:lib",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "release": "pnpm run build:lib && pnpm publish --access public",
    "test": "vitest --run",
    "test-storybook": "vitest --run --project=storybook",
    "test:unit": "vitest --run --project=unit",
    "validate:designer-bundles": "node scripts/validate-designer-bundles.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run validate:designer-bundles && pnpm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react": "10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.30",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.6.3",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "ws": ">=8.20.1",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "fast-uri": ">=3.1.2"
    }
  }
}
